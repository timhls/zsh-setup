# ============================================================================
# ALIASES - GENERAL
# ============================================================================

alias ll='ls -lah'          # Long format with all files
alias la='ls -la'           # Long format with hidden files
alias l='ls -l'             # Long format
alias ...='cd ../..'        # Go up 2 directories
alias ....='cd ../../..'    # Go up 3 directories

# ============================================================================
# ALIASES - GIT
# ============================================================================

alias gs='git status'
alias gc='git commit'
alias gcm='git commit -m'
alias gp='git push'
alias gpl='git pull'
alias gb='git branch'
alias gco='git checkout'
alias gd='git diff'
alias gl='git log --oneline'
alias gla='git log --oneline --all --graph --decorate'

# ============================================================================
# ALIASES - DEVELOPMENT
# ============================================================================

# Node.js / npm
alias npm-list='npm list --depth=0'

# Python
alias python='python3'
alias pip='pip3'

# Docker (if installed)
if command -v docker &> /dev/null; then
    alias d='docker'
    alias dc='docker compose'
    alias dcu='docker compose up'
    alias dcd='docker compose down'
fi

# Kubernetes (if kubectl installed)
if command -v kubectl &> /dev/null; then
    alias k='kubectl'
    alias kg='kubectl get'
    alias kd='kubectl describe'
    alias kl='kubectl logs'
    alias kex='kubectl exec -it'
fi

# ============================================================================
# ALIASES - DEVOPS & SYSTEM
# ============================================================================

alias grep='grep --color=auto'
alias diff='diff --color=auto'
alias ip='ip --color=auto'

# Quick edit config files
alias zshconfig='${EDITOR} ~/.zshrc'
alias zshreload='source ~/.zshrc'

# ============================================================================
# ENVIRONMENT VARIABLES
# ============================================================================

# Default editor
export EDITOR='nano'
# export EDITOR='vim'  # Uncomment if you prefer vim

# Less paging configuration
export LESS='-R -S -F -X'

# ============================================================================
# LANGUAGE & LOCALE
# ============================================================================

export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8

# ============================================================================
# PATH CONFIGURATION
# ============================================================================

# Ensure local bin is in PATH
export PATH="$HOME/.local/bin:$PATH"

# Add cargo (Rust) to PATH if installed
if [ -f "$HOME/.cargo/env" ]; then
    . "$HOME/.cargo/env"
fi

# ============================================================================
# WSL2-SPECIFIC CONFIGURATION
# ============================================================================

if [[ -n "$WSL_DISTRO_NAME" ]]; then
    # Performance optimization: use /tmp for temp files
    export TEMP=/tmp
    export TMP=/tmp
    
    # Optional: Enable Windows interop features
    # export DISPLAY=$(cat /etc/resolv.conf | grep nameserver | awk '{print $2}'):0
    
    # WSL2 has slower disk I/O to Windows filesystem, work in Linux home when possible
fi

# ============================================================================
# FUNCTIONS
# ============================================================================

# Create and enter a directory
mcd() {
    mkdir -p "$1" && cd "$1"
}

# Extract archives automatically
extract() {
    if [ -f "$1" ]; then
        case "$1" in
            *.tar.bz2)   tar xjf "$1"   ;;
            *.tar.gz)    tar xzf "$1"   ;;
            *.bz2)       bunzip2 "$1"   ;;
            *.rar)       unrar x "$1"   ;;
            *.gz)        gunzip "$1"    ;;
            *.tar)       tar xf "$1"    ;;
            *.tbz2)      tar xjf "$1"   ;;
            *.tgz)       tar xzf "$1"   ;;
            *.zip)       unzip "$1"     ;;
            *.Z)         uncompress "$1";;
            *.7z)        7z x "$1"      ;;
            *)           echo "'$1' cannot be extracted via extract()" ;;
        esac
    else
        echo "'$1' is not a valid file"
    fi
}

