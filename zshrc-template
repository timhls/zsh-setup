# ============================================================================
# zsh Configuration Template
# For: macOS & Ubuntu/WSL2
# Developer & DevSecOps Optimized
# ============================================================================

# ============================================================================
# HISTORY CONFIGURATION
# ============================================================================

HISTFILE=~/.zsh_history
HISTSIZE=50000              # In-memory history size
SAVEHIST=50000              # Saved history size

# History options
setopt EXTENDED_HISTORY     # Save timestamp and duration
setopt SHARE_HISTORY        # Share history between sessions in real-time
setopt APPEND_HISTORY       # Append to history file, don't replace
setopt HIST_IGNORE_DUPS     # Don't save duplicate commands
setopt HIST_FIND_NO_DUPS    # Skip duplicates when searching
setopt HIST_IGNORE_SPACE    # Don't save commands starting with space (secret commands)
setopt HIST_REDUCE_BLANKS   # Remove extra blank lines

# ============================================================================
# COMPLETION CONFIGURATION
# ============================================================================

# Initialize completion system
# -i: silently skip insecure directories. Homebrew ships /opt/homebrew/share
# as group-writable (mode 775); without -i, compinit prompts interactively
# with "insecure directories" on every new zsh session.
autoload -Uz compinit
compinit -i

# Load completion menu module (enables interactive selection)
zmodload zsh/complist

# Completion options
setopt MENU_COMPLETE              # Automatically use first completion on TAB
setopt AUTO_LIST                  # Show list on ambiguous completion
setopt COMPLETE_IN_WORD           # Complete inside words, not just at end
setopt ALWAYS_TO_END              # Move cursor to end when completing

# Completion styling
zstyle ':completion:*:matches' group 'yes'
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' '+r:|=**'  # Case-insensitive

# ============================================================================
# DIRECTORY NAVIGATION
# ============================================================================

# Auto cd: just type directory name to cd into it
setopt AUTO_CD

# Automatically pushd when changing directories
setopt AUTO_PUSHD

# Don't push duplicates onto the directory stack
setopt PUSHD_IGNORE_DUPS

# Track directory stack size
DIRSTACKSIZE=20

# ============================================================================
# COMMAND CORRECTION & BEHAVIOR
# ============================================================================

# Enable command correction (optional - can be annoying)
setopt CORRECT

# Enable interactive comments on command line (not just in scripts)
setopt interactive_comments

# ============================================================================
# KEY BINDINGS
# ============================================================================

# Use emacs key bindings
bindkey -e

# Fix Delete key issue (sends tilde instead of deleting)
bindkey "^[[3~" delete-char
bindkey "^[[3;5~" delete-word

# History substring search bindings (if using history-substring-search plugin)
bindkey "$terminfo[kcuu1]" history-substring-search-up
bindkey "$terminfo[kcud1]" history-substring-search-down

# ============================================================================
# PLATFORM-SPECIFIC SETUP
# ============================================================================

# Detect platform
if [[ "$OSTYPE" == "darwin"* ]]; then
    # macOS
    PLATFORM="macos"
    export HOMEBREW_PREFIX=$(brew --prefix)
elif [[ "$OSTYPE" == "linux-gnu"* ]]; then
    # Linux/WSL2
    PLATFORM="linux"
    if [[ -n "$WSL_DISTRO_NAME" ]]; then
        export WSL_DETECTED=true
    fi
fi

# ============================================================================
# PLUGIN LOADING
# ============================================================================

# Color output for common commands
export CLICOLOR=1

# zsh-syntax-highlighting (MUST be loaded first)
if [[ "$PLATFORM" == "macos" ]]; then
    if [ -f "$HOMEBREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]; then
        source "$HOMEBREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
    fi
else
    if [ -f /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]; then
        source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
    fi
fi

# zsh-autosuggestions (load AFTER syntax-highlighting)
if [[ "$PLATFORM" == "macos" ]]; then
    if [ -f "$HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh" ]; then
        source "$HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
    fi
else
    if [ -f /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]; then
        source /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh
    fi
fi

# zsh-history-substring-search
if [[ "$PLATFORM" == "macos" ]]; then
    if [ -f "$HOMEBREW_PREFIX/share/zsh-history-substring-search/zsh-history-substring-search.zsh" ]; then
        source "$HOMEBREW_PREFIX/share/zsh-history-substring-search/zsh-history-substring-search.zsh"
    fi
else
    if [ -f /usr/share/zsh-history-substring-search/zsh-history-substring-search.zsh ]; then
        source /usr/share/zsh-history-substring-search/zsh-history-substring-search.zsh
    elif [ -f ~/.zsh-plugins/zsh-history-substring-search/zsh-history-substring-search.zsh ]; then
        source ~/.zsh-plugins/zsh-history-substring-search/zsh-history-substring-search.zsh
    fi
fi

# z - frecent folder navigation
if [[ "$PLATFORM" == "macos" ]]; then
    if [ -f "$HOMEBREW_PREFIX/etc/profile.d/z.sh" ]; then
        source "$HOMEBREW_PREFIX/etc/profile.d/z.sh"
    fi
else
    if [ -f ~/.z-repo/z.sh ]; then
        source ~/.z-repo/z.sh
    fi
fi

# fzf - fuzzy finder key bindings
if [ -f ~/.fzf.zsh ]; then
    source ~/.fzf.zsh
fi

