#!/usr/bin/env bash
# agentctl — manage global MCP enablement profiles across coding agents.
#
# Single source of truth: ~/apm.yml (mcp: section) defines WHICH servers exist
# and their canonical config. This tool only flips `enabled` flags in each
# agent's global config — it never rewrites transports/URLs/keys.
#
# Managed agents: claude (Claude Code), codex, opencode, omp.
#   claude   ~/.claude.json                       (user-scope mcpServers; absence of config = enabled)
#   codex    ~/.codex/config.toml                 ([mcp_servers.<name>] enabled = true/false)
#   opencode ~/.config/opencode/opencode.jsonc    (mcp.<name>.enabled true/false, default true)
#   omp      ~/.omp/agent/mcp.json                (mcpServers.<name>.enabled, default true)
#
# Hindsight MCP is agent-native integration — never touched here.
# omp cannot expand {env:}; its config stays literal-key (0600) and is synced
# manually from apm.yml (see README).
#
# Usage:
#   agentctl status                 show enablement matrix across agents
#   agentctl mcp on|off <name> [--agent a,b]   flip one server
#   agentctl profile <name>         apply a profile (lean default + extras)
#   agentctl profiles               list profiles
#   agentctl skills                 resync ~/.agents/skills -> ~/.opencode/skill symlinks
#   agentctl fixhooks               repair apm-deployed claude hooks: repoint
#                                   PLUGIN_ROOT refs, prune dead script hooks,
#                                   dedupe repeated registrations, deploy
#                                   gh-cli shims/ that apm's deploy skips

set -euo pipefail

HOME_DIR="$HOME"
CLAUDE_JSON="$HOME_DIR/.claude.json"
CODEX_TOML="$HOME_DIR/.codex/config.toml"
OPENCODE_JSONC="$HOME_DIR/.config/opencode/opencode.jsonc"
OMP_JSON="$HOME_DIR/.omp/agent/mcp.json"
APM_YML="$HOME_DIR/apm.yml"

# Servers managed per profile (must exist in apm.yml mcp: section)
ALWAYS_ON="zai-vision zai-websearch zai-webreader zai-zread"
PROFILES=(
  "lean: (defaults only) zai trio + zai-vision"
  "azure: lean + azure"
  "security: lean + snyk"
  "data: lean + dbhub"
  "docs: lean + context7 + markitdown"
  "github: lean + github"
  "comms: lean + gog"
  "gateway: lean + omniroute"
  "all: every server in apm.yml enabled"
)

read -r -a ON_SERVERS <<< "$ALWAYS_ON"

die() { echo "error: $*" >&2; exit 1; }

known_servers() {
  python3 - "$APM_YML" <<'PY'
import sys, yaml
d = yaml.safe_load(open(sys.argv[1]))
for m in (d.get('dependencies') or {}).get('mcp') or []:
    print(m['name'] if isinstance(m, dict) else m.split('/')[-1])
PY
}

# --- per-agent enable/disable -------------------------------------------------
# claude: user-scope ~/.claude.json has no per-server enabled flag; presence = enabled.
# To disable we remove the entry; to enable we re-add from apm.yml canonical def.
claude_set() { # $1=name $2=on|off
  python3 - "$CLAUDE_JSON" "$APM_YML" "$1" "$2" <<'PY'
import sys, json, yaml
cj, apm, name, state = sys.argv[1:5]
d = json.load(open(cj))
if state == 'off':
    d.setdefault('mcpServers', {}).pop(name, None)
else:
    man = yaml.safe_load(open(apm))
    entry = None
    for m in (man.get('dependencies') or {}).get('mcp') or []:
        if isinstance(m, dict) and m.get('name') == name:
            entry = m; break
    if entry is None: sys.exit(f"{name} not in apm.yml")
    if entry.get('transport') in ('http', 'sse', 'streamable-http'):
        cfg = {'type': 'http', 'url': entry['url']}
        hdrs = entry.get('headers') or {}
        if hdrs: cfg['headers'] = {k: v.replace('{env:', '${').rstrip('}') if '{env:' in v else v for k, v in hdrs.items()}
    else:
        cfg = {'type': 'stdio', 'command': entry['command'], 'args': entry.get('args', [])}
        env = entry.get('env') or {}
        if env: cfg['env'] = {k: ('${' + v[len('{env:'):-1] + '}') if v.startswith('{env:') else v for k, v in env.items()}
    d.setdefault('mcpServers', {})[name] = cfg
json.dump(d, open(cj, 'w'), indent=2)
PY
}

codex_set() { # $1=name $2=on|off
  python3 - "$CODEX_TOML" "$1" "$2" <<'PY'
import sys, re
path, name, state = sys.argv[1:4]
want = 'true' if state == 'on' else 'false'
HDR_RE = re.compile(r'^\[\[?[\w."\-/:]+\]\]?\s*$')  # TOML header; array lines w/ commas never match
lines = open(path).read().splitlines(keepends=True)
hdr = f'[mcp_servers.{name}]'
out, i, seen, wrote = [], 0, False, False
while i < len(lines):
    ln = lines[i]
    if ln.rstrip('\n') == hdr:
        seen = True
        out.append(ln)
        i += 1
        while i < len(lines) and not HDR_RE.match(lines[i].rstrip('\n')):
            if lines[i].strip().startswith('enabled'):
                if not wrote:
                    out.append(f'enabled = {want}\n'); wrote = True
            else:
                out.append(lines[i])
            i += 1
        if not wrote:
            out.append(f'enabled = {want}\n'); wrote = True
        continue
    out.append(ln)
    i += 1
if not seen:
    out.append(f'\n{hdr}\nenabled = {want}\n')
open(path, 'w').write(''.join(out))
PY
}

opencode_set() { # $1=name $2=on|off
  node -e "
const fs=require('fs'); const p=process.argv[1], name=process.argv[2], on=process.argv[3]==='on';
let s=fs.readFileSync(p,'utf8');
s=s.replace(/\/\*[\s\S]*?\*\//g,'').replace(/(^|[^:])\/\/[^\n]*/g,'\$1');
const d=JSON.parse(s);
if(!d.mcp) die; 
if(!d.mcp[name]){ console.error('opencode: no entry '+name); process.exit(1); }
d.mcp[name].enabled=on;
fs.writeFileSync(p, JSON.stringify(d,null,2)+'\n');
" "$OPENCODE_JSONC" "$1" "$2"
}

omp_set() { # $1=name $2=on|off
  python3 - "$OMP_JSON" "$1" "$2" <<'PY'
import sys, json
p, name, state = sys.argv[1:4]
d = json.load(open(p))
srv = d.get('mcpServers', {})
if name not in srv: sys.exit(f"omp: no entry {name}")
srv[name]['enabled'] = state == 'on'
json.dump(d, open(p, 'w'), indent=2)
PY
}

AGENTS="claude codex opencode omp"
set_server() { # $1=name $2=on|off $3=agents csv (default all)
  local name=$1 state=$2 agents=${3:-$AGENTS}
  local a
  for a in ${agents//,/ }; do
    case "$a" in
      claude)   claude_set "$name" "$state" || echo "  claude: skip $name" ;;
      codex)    codex_set "$name" "$state" || echo "  codex: skip $name" ;;
      opencode) opencode_set "$name" "$state" || echo "  opencode: skip $name" ;;
      omp)      omp_set "$name" "$state" || echo "  omp: skip $name" ;;
      *) die "unknown agent: $a" ;;
    esac
  done
}

# --- status --------------------------------------------------------------------
cmd_status() {
  python3 - "$CLAUDE_JSON" "$CODEX_TOML" "$OPENCODE_JSONC" "$OMP_JSON" <<'PY'
import sys, json, re
cj, ct, oc, om = sys.argv[1:5]
def strip(s): return re.sub(r'(^|[^:])//[^\n]*', r'\1', re.sub(r'/\*[\s\S]*?\*/', '', s))
claude = json.load(open(cj)).get('mcpServers', {})
codex = {}
HDR_RE = re.compile(r'^\[\[?[\w."\-/:]+\]\]?\s*$')
cur, cur_en = None, None
for ln in open(ct):
    ln = ln.rstrip('\n')
    if HDR_RE.match(ln) and ln.startswith('[mcp_servers.'):
        if cur is not None: codex[cur] = (cur_en == 'true') if cur_en else True
        cur = ln[len('[mcp_servers.'):].rstrip(']'); cur_en = None
    elif HDR_RE.match(ln):
        if cur is not None: codex[cur] = (cur_en == 'true') if cur_en else True
        cur, cur_en = None, None
    elif cur is not None:
        m = re.match(r'\s*enabled\s*=\s*(true|false)\s*$', ln)
        if m: cur_en = m.group(1)
if cur is not None: codex[cur] = (cur_en == 'true') if cur_en else True
ocj = json.loads(strip(open(oc).read())).get('mcp', {})
omp = json.load(open(om)).get('mcpServers', {})
names = sorted(set(claude) | set(codex) | set(ocj) | set(omp) - {'hindsight'})
names = [n for n in names if n != 'hindsight']
def mark(x): return ' ON ' if x else ' off'
hdr = f"{'server':<16} {'claude':<7} {'codex':<7} {'opencode':<9} omp"
print(hdr); print('-' * len(hdr))
for n in names:
    c = n in claude  # presence = on (claude user scope)
    x = codex.get(n, False)
    o = ocj.get(n, {}).get('enabled', True) if n in ocj else False
    m = omp.get(n, {}).get('enabled', True) if n in omp else False
    print(f"{n:<16} {mark(c):<7} {mark(x):<7} {mark(o):<9} {mark(m)}")
print("\n(hindsight: agent-native, not managed)")
PY
}

# --- profiles ------------------------------------------------------------------
profile_servers() {
  case "$1" in
    lean)     echo "" ;;
    azure)    echo "azure" ;;
    security) echo "snyk" ;;
    data)     echo "dbhub" ;;
    docs)     echo "context7 markitdown" ;;
    github)   echo "github" ;;
    comms)    echo "gog" ;;
    gateway)  echo "omniroute" ;;
    all)      known_servers ;;
    *) return 1 ;;
  esac
}

cmd_profile() {
  local p=$1
  profile_servers "$p" >/dev/null 2>&1 || { echo "unknown profile: $p"; cmd_profiles; exit 1; }
  local all extras
  all=$(known_servers)
  extras=$(profile_servers "$p")
  echo "Applying profile '$p': ON = $ALWAYS_ON $extras"
  for s in $all; do
    if echo " $ALWAYS_ON $extras " | grep -q " $s "; then set_server "$s" on
    else set_server "$s" off; fi
  done
}

cmd_profiles() {
  echo "Profiles (lean = zai trio + zai-vision always on):"
  for p in "${PROFILES[@]}"; do echo "  ${p%%:*} — ${p#*: }"; done
}

# --- skills sync ----------------------------------------------------------------
cmd_skills() {
  local src="$HOME_DIR/.agents/skills" dst="$HOME_DIR/.opencode/skill" n=0
  mkdir -p "$dst"
  for d in "$src"/*/; do
    name=$(basename "$d")
    [[ -e "$dst/$name" && ! -L "$dst/$name" ]] && { echo "skip (non-symlink): $name"; continue; }
    ln -sfn "$d" "$dst/$name"; n=$((n+1))
  done
  echo "synced $n skill symlinks -> $dst"
}

# --- fixhooks: repair apm-deployed claude hooks ---------------------------------
# 1. repoint ${CLAUDE_PLUGIN_ROOT} refs at ~/.claude/hooks/gh-cli/ (as before)
# 2. prune dead apm script hooks: entries whose `bash "<path>.sh"` target no
#    longer exists (removed packages leave stale registrations behind)
# 3. dedupe identical (event, matcher, command) registrations (apm appends on
#    every install without reconciling)
# 4. deploy gh-cli shims/ that apm's hook deploy misses (it copies only
#    top-level *.sh, not subdirectories)
# Never touches: statusLine, Orca blobs (inline shell), Hindsight (node "..."),
# compound commands (SCRIPT=... guards) — only exact `bash "<path>.sh"` shapes.
cmd_fixhooks() {
  python3 - "$HOME_DIR/.claude/hooks/gh-cli" <<'PY'
import sys, json, os, re, glob, shutil
hooks_dir = sys.argv[1]
apm_modules = os.path.expanduser('~/apm_modules')
claude_hooks = os.path.expanduser('~/.claude/hooks')
targets = [
    os.path.expanduser('~/.claude/apm-hooks.json'),
    os.path.expanduser('~/.claude/settings.json'),
]
SCRIPT_RE = re.compile(r'^bash "([^"]+\.sh)"$')

def command_alive(cmd):
    """True/False for plain `bash "<path>.sh"` commands; None = not ours to judge."""
    m = SCRIPT_RE.match(cmd.strip())
    if not m: return None
    path = m.group(1)
    if '${CLAUDE_PROJECT_DIR}' in path:
        # project-relative apm hook: alive iff the package is deployed or
        # still present in apm_modules (glob over the org/repo layout)
        seg = re.search(r'\.claude/hooks/([^/"]+)', path)
        if not seg: return False
        if os.path.isdir(os.path.join(claude_hooks, seg.group(1))): return True
        return bool(glob.glob(f'{apm_modules}/**/{seg.group(1)}', recursive=True))
    return os.path.isfile(os.path.expanduser(path))

def repoint(obj):
    n = 0
    def walk(o):
        nonlocal n
        if isinstance(o, dict):
            for k, v in o.items():
                if k == 'command' and isinstance(v, str) and 'PLUGIN_ROOT' in v:
                    script = v.split('/')[-1].rstrip('\\"')
                    o[k] = f'bash "{hooks_dir}/{script}"'
                    n += 1
                else:
                    walk(v)
        elif isinstance(o, list):
            for x in o: walk(x)
    walk(obj)
    return n

def prune_dedupe(events):
    seen, dead, dup = set(), 0, 0
    for ev, groups in events.items():
        if not isinstance(groups, list): continue
        kept = []
        for g in groups:
            if not isinstance(g, dict) or not isinstance(g.get('hooks'), list):
                kept.append(g); continue
            kh = []
            for h in g['hooks']:
                cmd = h.get('command') if isinstance(h, dict) else None
                if not isinstance(cmd, str): kh.append(h); continue
                if command_alive(cmd) is False:
                    dead += 1
                    print(f'  prune dead [{ev}]: {cmd}')
                    continue
                key = (ev, g.get('matcher'), cmd)
                if key in seen:
                    dup += 1
                    print(f'  dedupe    [{ev}]: {cmd}')
                    continue
                seen.add(key)
                kh.append(h)
            if kh:
                g['hooks'] = kh
                kept.append(g)
        events[ev] = kept
    return dead, dup

for p in targets:
    if not os.path.exists(p): continue
    try:
        d = json.load(open(p))
    except Exception as e:
        print(f'skip {p}: {e}'); continue
    n = repoint(d)
    dead = dup = 0
    # settings.json nests events under "hooks"; apm-hooks.json has them top-level
    if isinstance(d.get('hooks'), dict):
        dead, dup = prune_dedupe(d['hooks'])
    elif d and all(isinstance(v, list) for v in d.values()):
        dead, dup = prune_dedupe(d)
    json.dump(d, open(p, 'w'), indent=2)
    print(f'{p}: repointed {n}, pruned {dead}, deduped {dup}')

shims_dst = os.path.join(hooks_dir, 'shims')
if os.path.isdir(shims_dst):
    print('shims: present')
elif os.path.isfile(os.path.join(hooks_dir, 'setup-shims.sh')):
    src = glob.glob(f'{apm_modules}/**/gh-cli/hooks/shims', recursive=True)
    if src:
        shutil.copytree(sorted(src)[0], shims_dst)
        print(f'shims: deployed {sorted(src)[0]} -> {shims_dst}')
    else:
        print('shims: no source in apm_modules; left missing')
PY
}

case "${1:-}" in
  status)  cmd_status ;;

  mcp)
    [[ $# -ge 3 ]] || die "usage: agentctl mcp on|off <name> [--agent a,b]"
    state=$2; name=$3; agents=$AGENTS
    [[ ${4:-} == "--agent" ]] && agents=$5
    [[ $state == on || $state == off ]] || die "state must be on|off"
    set_server "$name" "$state" "$agents"
    ;;
  profile) [[ -n ${2:-} ]] || die "usage: agentctl profile <name>"; cmd_profile "$2" ;;
  profiles) cmd_profiles ;;
  skills)  cmd_skills ;;
  fixhooks) cmd_fixhooks ;;

  *) echo "usage: agentctl status | mcp on|off <name> [--agent a,b] | profile <name> | profiles | skills | fixhooks"; exit 1 ;;
esac
